# Backend (run from backend/)
BLOG_ADDR=:8080
BLOG_DB_PATH=./data/blog.db
BLOG_CONTENT_DIR=./content/posts
BLOG_WEB_DIR=../frontend/dist
BLOG_LOG_LEVEL=info
BLOG_LOG_FORMAT=json

# Leave the editor key empty for a read-only site. Use different random values.
# Editor key: at least 16 characters. JWT signing secret: at least 32 characters.
BLOG_EDITOR_KEY=
BLOG_JWT_SECRET=
BLOG_TOKEN_TTL=8h
# Enable when the public site uses HTTPS.
BLOG_COOKIE_SECURE=false
BLOG_MAX_TAGS=10

# Runtime uploads; back up this directory together with content/posts and SQLite.
BLOG_UPLOAD_DIR=./data/uploads
BLOG_UPLOAD_MAX_MB=100

# Vite development proxy; update this when changing BLOG_ADDR's port.
BLOG_DEV_API_TARGET=http://127.0.0.1:8080
